{
  "name": "hamada-live-web",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat"],
  "containers": [
    {
      "class_name": "HamadaContainer",
      "image": "./Dockerfile",
      "max_instances": 1,
      "instance_type": "lite",
      "constraints": { "regions": ["ME", "WEUR"] }
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "HAMADA_CONTAINER", "class_name": "HamadaContainer" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["HamadaContainer"] }
  ],
  "observability": { "enabled": true }
}
